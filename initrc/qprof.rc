service qprof_prepare /system/bin/sh /data/adb/modules/qprof_autostart/prepare-qprof.sh
    class late_start
    user root
    group root
    disabled
    oneshot
    seclabel u:r:ksu:s0

service qprof_autostart /system/bin/sh /data/adb/modules/qprof_autostart/qprof-launch.sh
    class late_start
    user root
    group root
    disabled
    seclabel u:r:su:s0

on property:sys.boot_completed=1
    start qprof_prepare

on property:sys.qprof.ready=1
    start qprof_autostart
